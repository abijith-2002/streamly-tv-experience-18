<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV -->
    <style name="AppTheme" parent="Theme.Leanback">
        <!-- Keep dark background -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>

        <!-- Accent applied using supported attributes in Leanback -->
        <item name="android:colorPrimary">@color/tv_accent</item>

        <!-- Legacy accent attribute for wider widget compatibility -->
        <item name="android:colorAccent">@color/tv_accent</item>
    </style>

    <!-- Splash theme: ONLY dark background, no splash icons or animated assets -->
    <style name="SplashTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
        <!-- No windowSplashScreenAnimatedIcon or content to ensure only background color + layout text -->
    </style>
</resources>
